{
  "expo": {
    "name": "Hablo",
    "slug": "ai-lang-learn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hablo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "dev.svindland.hablo",
      "appleTeamId": "9HAG9PT8LJ",
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Hablo transcribes your speech on-device to check your pronunciation.",
        "NSMicrophoneUsageDescription": "Hablo uses the microphone so you can practice speaking.",
        "NSPhotoLibraryUsageDescription": "Hablo only accesses your photo library if you choose to save or select an image.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.svindland.hablo",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hablo uses the microphone so you can practice speaking.",
          "speechRecognitionPermission": "Hablo transcribes your speech on-device to check your pronunciation.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Hablo uses the microphone so you can practice speaking."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E4572E"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-asset",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0543a0a7-6d8f-4ffa-acba-181aac5f82cc"
      }
    }
  }
}
