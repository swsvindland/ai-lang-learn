# Copy to .env.local (gitignored) or set as EAS environment variables.
# Everything here is optional: without it, the app offers on-device AI and bring-your-own OpenRouter key only.

# Hablo Plus subscription (see server/ai-proxy/README.md)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_AI_PROXY_URL=
# RevenueCat entitlement id; defaults to "plus"
EXPO_PUBLIC_PLUS_ENTITLEMENT=
